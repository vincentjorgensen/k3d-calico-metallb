---
networks:
  default:
    driver: bridge
    external: true
    name: {{ network}}
services:
  registry:
    container_name: k3d-dockerproxy
    environment:
      K3S_KUBECONFIG_OUTPUT: /output/kubeconfig.yaml
    healthcheck:
      interval: 10s
      retries: 3
      start_interval: 1s
      start_period: 10s
      #test: ["CMD", "nc", "-vz", "localhost", "{{ k3s_registry_port_internal }}"]
      test: ["CMD", "wget", "-q", "localhost:{{ k3s_registry_port_internal }}/v2/", "-O", "/dev/null"]
      timeout: 3s
    hostname: k3d-dockerproxy
    image: ligfx/k3d-registry-dockerd:{{ ligfx_ver }}
    init: true
    labels:
      app: k3d
      k3d.cluster: ""
      k3d.registry.host: ""
      k3d.registry.hostIP: 0.0.0.0
      k3d.role: registry
      k3d.version: {{ k3d_ver }}
      k3s.registry.port.external: {{ k3s_registry_port_external }}
      k3s.registry.port.internal: {{ k3s_registry_port_internal }}
    networks:
      default:
        ipv4_address: {{ registry_ip }}
    ports:
    - name: registry
      target: {{ k3s_registry_port_internal }}
      published: "{{ k3s_registry_port_external }}"
      host_ip: 0.0.0.0
      protocol: tcp
    privileged: true
    restart: unless-stopped
    security_opt:
    - label=disable
    tmpfs:
    - /run
    - /var/run
    userns_mode: host
    volumes:
    - /var/run/docker.sock:/var/run/docker.sock:rw
    - /etc/localtime:/etc/localtime:ro
...
